new Chart(document.getElementById('moldChart'), {
    type: 'line',
    data: {
        labels: ['4 день', '8 день', '12 день'],
        datasets: [
            { label: '1А', data: [4, 5, 5], borderColor: '#002060', backgroundColor: '#002060', pointRadius: 5, pointHoverRadius: 7, borderWidth: 2, tension: 0.25 },
            { label: '1Б', data: [5, 8, 9], borderColor: '#3D5C9E', backgroundColor: '#3D5C9E', pointRadius: 5, pointHoverRadius: 7, borderWidth: 2, tension: 0.25 },
            { label: '1В', data: [7, 12, 14], borderColor: '#B4C7E7', backgroundColor: '#B4C7E7', pointRadius: 5, pointHoverRadius: 7, borderWidth: 2, tension: 0.25 }
        ]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 1400, easing: 'easeOutQuart' },
        interaction: { mode: 'index', intersect: false },
        plugins: {
            legend: { display: false },
            tooltip: {
                backgroundColor: '#E1E9F5',
                titleColor: '#002060',
                bodyColor: '#002060',
                borderColor: '#B4C7E7',
                borderWidth: 1,
                padding: 10,
                callbacks: { label: (ctx) => ctx.dataset.label + ': ' + ctx.parsed.y + '%' }
